SLACKQUERY_CANONICAL_DB=/path/to/slackpipe.duckdb
SLACKQUERY_STATE_DB=/srv/slackquery/state/slackquery.duckdb
SLACKQUERY_ARTIFACT_DIR=/srv/slackquery/artifacts
SLACKQUERY_CURRENT_LINK=/srv/slackquery/artifacts/current.duckdb
SLACKQUERY_DUCKDB_EXTENSION_DIR=/srv/slackquery/extensions
SLACKQUERY_ATTACHMENT_ROOT=/srv/slackquery/attachments
EMBEDDING_BACKEND=pytorch
PYTORCH_EMBEDDING_BASE_URL=http://embedding-host:11435
# Required by the bundled PyTorch server; use the same value on client and server.
# EMBEDDING_API_KEY=generate-a-long-random-secret
OLLAMA_EMBEDDING_BASE_URL=http://ollama-host:11434
# Optional common override; when set it takes precedence over the backend-specific URL.
# EMBEDDING_BASE_URL=http://embedding-host:11435
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIM=512
SLACKQUERY_EMBEDDING_BUSY_MAX_ATTEMPTS=8
SLACKQUERY_EMBEDDING_BUSY_DEADLINE_SECONDS=30
SLACKQUERY_EMBEDDING_BUSY_BACKOFF_BASE_SECONDS=0.25
SLACKQUERY_EMBEDDING_BUSY_BACKOFF_CAP_SECONDS=5
# Recommended: pin the exact digest reported by the embedding server.
# SLACKQUERY_EMBEDDING_MODEL_REVISION=sha256-digest-from-your-server
# Required for reproducible PyTorch generations using remote model code.
# SLACKQUERY_EMBEDDING_CODE_REVISION=40-character-code-commit
SLACKQUERY_HOST=0.0.0.0
SLACKQUERY_PORT=8080
SLACKQUERY_EMBEDDING_BATCH_SIZE=32
# Cap CUDA requests separately for low-memory GPUs.
SLACKQUERY_PYTORCH_EMBEDDING_BATCH_SIZE=1
# SLACKQUERY_BEARER_TOKEN=replace-me

# Compose host paths and published address.
SLACKQUERY_CANONICAL_DB_HOST=/path/to/slackpipe.duckdb
SLACKQUERY_STATE_DIR_HOST=/srv/slackquery/state
SLACKQUERY_ARTIFACT_DIR_HOST=/srv/slackquery/artifacts
SLACKQUERY_EXTENSION_DIR_HOST=/srv/slackquery/extensions
SLACKQUERY_ATTACHMENT_ROOT_HOST=/path/to/slackdump
SLACKQUERY_BIND_ADDRESS=127.0.0.1
SLACKQUERY_MCP_PORT=8181
